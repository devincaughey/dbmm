if (nzchar(Sys.getenv("DBMM_SAVE_FITS"))) {
    save_dbmm(fit2, "~/dbmm-vignette-fit2.rds")
    save_dbmm(fit1, "~/dbmm-vignette-fit1.rds")
}
```
